PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/qamarflow.db
CLIENT_URL=http://localhost:5173
# Use long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Optional: without it, mail is printed to the console
SENDGRID_API_KEY=
MAIL_FROM=no-reply@qamarflow.local
# Optional: without it, /api/media returns picsum images
UNSPLASH_ACCESS_KEY=
